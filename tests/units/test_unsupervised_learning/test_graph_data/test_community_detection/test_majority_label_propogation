
import pytest
import networkx as nx
import warnings
# We import the private function specifically for unit testing
from ml.unsupervised_learning.graph_data.community_detection.majority_label_propogation import (
    majority_label_propagation, _check_graph_simplicity
)

# --- Direct Unit Tests for _check_graph_simplicity ---

def test_check_simplicity_warns_on_self_loops():
    """
    Directly tests the helper function. 
    Should return False and trigger a UserWarning if self-loops exist.
    """
    G = nx.Graph()
    G.add_edge(1, 1) # Self-loop
    
    # Assert a UserWarning is raised (ignoring the specific message)
    with pytest.warns(UserWarning):
        result = _check_graph_simplicity(G)
        
    assert result is False

def test_check_simplicity_warns_on_multigraph():
    """
    Directly tests the helper function.
    Should return False and trigger a UserWarning if it is a MultiGraph.
    """
    G = nx.MultiGraph()
    G.add_edge(1, 2)
    
    # Assert a UserWarning is raised
    with pytest.warns(UserWarning):
        result = _check_graph_simplicity(G)
        
    assert result is False

def test_check_simplicity_clean_graph(recwarn):
    """
    Directly tests the helper function on a valid graph.
    Should return True and trigger NO warnings.
    """
    G = nx.Graph()
    G.add_edge(1, 2)
    
    # recwarn is a built-in pytest fixture that records warnings
    result = _check_graph_simplicity(G)
    
    assert result is True
    assert len(recwarn) == 0  # Verify no warnings were recorded

