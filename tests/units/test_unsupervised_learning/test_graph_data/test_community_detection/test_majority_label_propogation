# --- Functionality Tests ---

def test_simple_propagation():
    """
    Scenario: Node 1 is 'Red', connected to Node 2 (Unlabeled).
    Expected: Node 2 becomes 'Red'.
    """
    G = nx.Graph()
    G.add_edge(1, 2)
    G.nodes[1]['label'] = 'Red'
    
    G = majority_label_propagation(G, label_attr='label')
    
    assert G.nodes[2]['label'] == 'Red'

def test_disconnected_components():
    """
    Scenario: Two separate components.
    Comp A: 1('Red') -- 2
    Comp B: 3('Blue') -- 4
    Expected: 2 becomes 'Red', 4 becomes 'Blue'. Labels shouldn't mix.
    """
    G = nx.Graph()
    # Component 1
    G.add_edge(1, 2)
    G.nodes[1]['tag'] = 'Red' # Using custom attr name 'tag'
    
    # Component 2
    G.add_edge(3, 4)
    G.nodes[3]['tag'] = 'Blue'
    
    G = majority_label_propagation(G, label_attr='tag')
    
    assert G.nodes[2]['tag'] == 'Red'
    assert G.nodes[4]['tag'] == 'Blue'

def test_freeze_seeds_true():
    """
    Scenario: Freeze enabled. 
    Node 1 ('Red') connected to Node 2 ('Blue').
    Expected: Neither changes, because they are seeds and freeze=True.
    """
    G = nx.Graph()
    G.add_edge(1, 2)
    G.nodes[1]['label'] = 'Red'
    G.nodes[2]['label'] = 'Blue'
    
    G = majority_label_propagation(G, freeze_seeds=True)
    
    assert G.nodes[1]['label'] == 'Red'
    assert G.nodes[2]['label'] == 'Blue'

def test_freeze_seeds_false():
    """
    Scenario: Freeze disabled (Community Detection mode).
    Node 0 ('Blue') is surrounded by 3 'Red' neighbors.
    Expected: Node 0 changes to 'Red' via majority vote.
    """
    G = nx.Graph()
    # Central node 0 is Blue
    G.add_node(0, label='Blue')
    
    # 3 Neighbors are Red
    for i in range(1, 4):
        G.add_edge(0, i)
        G.nodes[i]['label'] = 'Red'
        
    # Run with freeze_seeds=False, so Node 0 can change
    G = majority_label_propagation(G, freeze_seeds=False)
    
    assert G.nodes[0]['label'] == 'Red'

def test_no_seeds_no_change():
    """
    Scenario: A graph with edges but no initial labels.
    Expected: No labels are created from thin air.
    """
    G = nx.Graph()
    G.add_edge(1, 2)
    G.add_edge(2, 3)
    
    G = majority_label_propagation(G, label_attr='label')
    
    # Check that no 'label' attribute was added
    for n in G.nodes():
        assert 'label' not in G.nodes[n]

def test_bridge_tie_breaking():
    """
    Scenario: 1('A') -- 2 -- 3('B')
    Node 2 has exactly one neighbor 'A' and one neighbor 'B'.
    Expected: Node 2 becomes either 'A' or 'B'.
    """
    G = nx.Graph()
    G.add_edges_from([(1, 2), (2, 3)])
    G.nodes[1]['label'] = 'A'
    G.nodes[3]['label'] = 'B'
    
    G = majority_label_propagation(G)
    
    assert G.nodes[2]['label'] in ['A', 'B']